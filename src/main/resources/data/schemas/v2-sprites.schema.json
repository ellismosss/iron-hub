{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "V2 sprite index",
	"description": "Index of the curated sprite set shipped under data/v2/. Generated by tools/gen_v2_sprites.py from design/use_these_sprites — never hand-edited.",
	"type": "object",
	"required": ["version", "source", "sprites"],
	"additionalProperties": false,
	"properties": {
		"version": { "type": "integer", "minimum": 1 },
		"source": { "type": "string" },
		"sprites": {
			"type": "object",
			"minProperties": 400,
			"description": "key = family/name, matching data/v2/<key>.png",
			"propertyNames": { "pattern": "^(ui|icons)/[a-z0-9_]+(/[a-z0-9_]+)?$" },
			"additionalProperties": {
				"type": "object",
				"required": ["w", "h", "variants"],
				"additionalProperties": false,
				"properties": {
					"w": { "type": "integer", "minimum": 1 },
					"h": { "type": "integer", "minimum": 1 },
					"variants": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"description": "which theme variants the curated set ships for this sprite; a theme with no entry falls back to vanilla, exactly as a resource pack behaves in game",
						"items": { "enum": ["vanilla", "mystic", "dark"] }
					}
				}
			}
		}
	}
}
