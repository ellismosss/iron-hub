{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Storage location registry + allow-lists (ported from Thource/dude-wheres-my-stuff at the pin, BSD-2)",
	"type": "object",
	"required": ["_generated", "_source", "familyLabels", "storages"],
	"additionalProperties": false,
	"properties": {
		"_generated": {"type": "string"},
		"_source": {"type": "string"},
		"familyLabels": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {"type": "string", "minLength": 1}
		},
		"storages": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["family", "key", "name", "members", "automatic"],
				"additionalProperties": false,
				"properties": {
					"family": {"type": "string", "pattern": "^[a-z]+$"},
					"key": {"type": "string", "pattern": "^[a-zA-Z0-9_]+$"},
					"name": {"type": "string", "minLength": 1},
					"members": {"type": "boolean"},
					"automatic": {"type": "boolean"},
					"container": {"type": "string", "minLength": 1},
					"items": {
						"type": "array",
						"minItems": 1,
						"items": {"type": "integer", "minimum": 1}
					}
				}
			}
		}
	}
}
