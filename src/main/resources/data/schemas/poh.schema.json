{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Complete POH catalog (every room, hotspot and furniture; wiki room pages + per-furniture Infobox Construction)",
	"type": "object",
	"required": ["version", "spaces"],
	"additionalProperties": false,
	"properties": {
		"version": {"type": "integer", "minimum": 1},
		"sources": {"type": "object"},
		"spaces": {
			"type": "array",
			"minItems": 100,
			"items": {
				"type": "object",
				"required": ["id", "name", "tiers"],
				"additionalProperties": false,
				"properties": {
					"id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
					"name": {"type": "string", "minLength": 1},
					"room": {"type": "string"},
					"benefit": {"type": "string"},
					"icon": {"type": "integer", "minimum": 0},
					"tiers": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": ["id", "name", "page", "level", "reqs", "objectIds"],
							"additionalProperties": false,
							"properties": {
								"id": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"},
								"name": {"type": "string", "minLength": 1},
								"page": {"type": "string", "minLength": 1},
								"level": {"type": "integer", "minimum": 1, "maximum": 99},
								"reqs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
								"objectIds": {"type": "array", "minItems": 0, "items": {"type": "integer", "minimum": 1}},
								"icon": {"type": "integer", "minimum": 0},
								"materials": {
									"type": "array",
									"minItems": 0,
									"items": {
										"type": "object",
										"required": ["itemId", "name", "qty"],
										"additionalProperties": false,
										"properties": {
											"itemId": {"type": "integer", "minimum": 0},
											"name": {"type": "string", "minLength": 1},
											"qty": {"type": "integer", "minimum": 1}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
