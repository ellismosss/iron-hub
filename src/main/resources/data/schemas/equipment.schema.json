{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Every wearable in the game (Gear library)",
	"type": "object",
	"required": ["source", "generated", "statKeys", "items"],
	"additionalProperties": false,
	"properties": {
		"source": {
			"type": "string"
		},
		"generated": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"statKeys": {
			"type": "array",
			"minItems": 14,
			"maxItems": 14,
			"items": {
				"type": "string"
			}
		},
		"items": {
			"type": "array",
			"minItems": 3500,
			"items": {
				"type": "object",
				"required": ["name", "slot", "ids", "members", "stats"],
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"slot": {
						"type": "string",
						"enum": ["head", "cape", "neck", "ammo", "weapon", "2h",
							"body", "shield", "legs", "hands", "feet", "ring"]
					},
					"ids": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "integer",
							"minimum": 1
						}
					},
					"members": {
						"type": "boolean"
					},
					"stats": {
						"type": "array",
						"minItems": 14,
						"maxItems": 14,
						"items": {
							"type": "integer"
						}
					},
					"speed": {
						"type": "integer",
						"minimum": 1
					},
					"alch": {
						"type": "integer",
						"minimum": 1
					},
					"leagues": {
						"type": "boolean"
					}
				}
			}
		}
	}
}
