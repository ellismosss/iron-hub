        {"item": "SECATEURS", "formula": "quantity = FARMING_TOOLS_SECATEURS + FARMING_TOOLS_EXTRASECATEURS * 2; id = FARMING_TOOLS_FAIRYSECATEURS==1 ? FAIRY_ENCHANTED_SECATEURS : SECATEURS"},
        {"item": "WATERING_CAN_0", "formula": "type = FARMING_TOOLS_WATERINGCAN indexes WATERING_CAN_IDS; id = WATERING_CAN_IDS[type]; if id==-1 quantity 0, else quantity 1 with that id"},
