        {"item": "PLANT_CURE", "formula": "FARMING_TOOLS_PLANTCURE"},
        {"item": "BOTTOMLESS_COMPOST_BUCKET", "formula": "type = FARMING_TOOLS_BOTTOMLESS_BUCKET_TYPE (0 none,1 empty,2 compost,3 supercompost,4 ultracompost), charges = FARMING_TOOLS_BOTTOMLESS_BUCKET_QUANTITY; id = (type==0||type==1) ? BOTTOMLESS_COMPOST_BUCKET : BOTTOMLESS_COMPOST_BUCKET_FILLED; quantity = type==0 ? 0 : 1"},
        {"item": "BUCKET_EMPTY", "formula": "FARMING_TOOLS_BUCKETS + FARMING_TOOLS_EXTRABUCKETS * 32 + FARMING_TOOLS_EXTRA2BUCKETS * 256"},
